rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open access for the single shared admin config doc.
    // Trust model matches the prior PHP backend (no auth).
    // Lock down with Firebase Auth before exposing this site to untrusted users.
    match /config/{doc} {
      allow read: if true;
      allow write: if true;
    }
  }
}
